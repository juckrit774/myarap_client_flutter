// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// ⚠️ ต้องเป็น "MyARAP" ตัวใหญ่ให้ตรงกับที่ Windows รายงาน — agent อ่านชื่อ app ที่ติดตั้ง
// จาก Spotlight kMDItemDisplayName / CFBundleName ซึ่งมาจากค่านี้ ถ้าเป็น "myarap" ตัวเล็ก
// MYARAP catalog จะแยกเป็น 2 รายการ (unique index บน name เป็น case-sensitive) แล้ว
// policy ที่ตั้งกับตัวหนึ่งจะไม่มีผลกับอีกตัว (เจอของจริง 2026-08-03)
PRODUCT_NAME = MyARAP

// เวอร์ชันที่แสดง (CFBundleShortVersionString) — **ไม่ได้มาจาก pubspec.yaml**
// เพราะ Flutter บังคับ semver 3 ท่อน (`version: 1.0.0.3` ถูกปฏิเสธ: "Invalid version number")
// แต่ฝั่ง Windows ใช้ MSI ProductVersion 4 ท่อน — ต้องให้ตรงกันไม่งั้น inventory
// รายงานคนละเวอร์ชันสำหรับ agent ตัวเดียวกัน
// ⚠️ bump ที่นี่ให้ตรงกับ installer/product.wxs ทุกครั้ง
MYARAP_DISPLAY_VERSION = 1.0.0.16

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.myarap.myarap

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.myarap. All rights reserved.
